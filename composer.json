{
  "name": "noresponse/noresponse-php",
  "type": "library",
  "autoload": {
    "psr-4": {
      "NoResponse\\": "src/",
      "NoResponse\\Serializer\\": "src/NoResponse/Serializer/"
    }
  },
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.2",
    "galbar/jsonpath": ">=3.0",
    "guzzlehttp/guzzle": "^7.15.2",
    "doctrine/instantiator": "^1.3.1 || ^2.0",
    "doctrine/lexer": "^2.0 || ^3.0",
    "jms/metadata": "^2.6",
    "phpstan/phpdoc-parser": "^1.20",
    "brick/date-time": ">=0.7.0",
    "phpdocumentor/type-resolver": ">=1.8",
    "brick/math": ">=0.12.1"
  },
  "require-dev": {
    "laravel/pint": "1.29.0",
    "phpstan/phpstan": "2.1.44",
    "phpunit/phpunit": "^11.5.50 || ^12.5.8 || >=13.0.0"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "sort-packages": true,
    "process-timeout": 60
  },
  "scripts": {
    "test": [
      "./vendor/bin/phpunit --testdox --display-warnings --colors=always"
    ],
    "stan": [
      "./vendor/bin/phpstan analyse --memory-limit=2g --error-format=table"
    ]
  },
  "script-descriptions": {
    "test": "Run PhpUnit test scripts.",
    "stan": "Run PhpStan static analysis."
  }
}
